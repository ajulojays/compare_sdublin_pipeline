# Source this from the repository root after copying to config/paths.env.
export SDUBLIN_ROOT="$(pwd)"
export SDUBLIN_WORKDIR="$SDUBLIN_ROOT/work"
export SDUBLIN_THREADS=8
# Set to a complete, locally installed Kraken2 database:
export SDUBLIN_KRAKEN_DB=""
# Set to the directory containing Trimmomatic TruSeq3-PE-2.fa and NexteraPE-PE.fa:
export SDUBLIN_ADAPTER_DIR=""
# Set to a locally installed KrakenTools directory (if extract_kraken_reads.py is not on PATH):
export SDUBLIN_KRAKEN_TOOLS=""
# Set to a CheckM database installation directory:
export SDUBLIN_CHECKM_DATA_PATH=""
# Optional override: a text file with SRA run accessions, one per line.
export SDUBLIN_ACCESSION_LIST="$SDUBLIN_WORKDIR/0.0-raw/acclist.txt"
